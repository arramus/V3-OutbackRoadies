<?xml version="1.0"?>
<!-- Read by NPCSdcsCharacters (AvatarSdcsNpcController.SdcsLoadVerboseLogging,
     SdcsLoadJitterWindow and SdcsLoadPlayerCtrlOwnController). VerboseLogging
     gates the per-second diagnostic tags:
     GATE, YAW, ROOTMOTION, SPEED, RELOAD, READBACK, HOLD, AIMPITCH, CRAWLHIT,
     NAME (the frozen-name roll/restore line), and CVARIO (the re-place cvar
     save/restore/apply lines). Each of these sits behind the switch at its emit
     site: AvatarSdcsNpcController.cs, CrawlerAimPatches.cs and
     MinEventActionSdcsApplyLook.cs [SDCS-NAME]. The remaining animation-facing
     tags (ANIMDUMP, ANIMINV, WEAPON, HIT, UAI) are always on.
     JitterWindow gates the per-frame
     [SDCS-JIT] high-rate window: 5 s of per-frame upper-body layer hashes and
     normalizedTimes every 20 s, plus 3 s windows when a watched state changes.
     Turn it on for ONE fight, then back off. Defaults are false for
     VerboseLogging/JitterWindow.
     SdcsPitchPin is the per-frame entity.rotation.x pin for SDCS V4
     NPCs that kills the melee head-shake (the task's RotateTo thrashes the
     field 0.2 to 29 deg; the pin restores the physics-body pitch before the
     base pass reads it). DEFAULT TRUE; set false to A/B the old behaviour in
     the field without a rebuild. The once-per-entity clamp line is [SDCS-PITCHPIN].
     Progression (NPC progression Phase 1) is read by the controller's
     [SDCS-LEVEL] block: the per-level rates and the level cap behind the
     hidden level buff (SdcsNpcLevelBonus in Config/buffs.xml). HealthPerLevel
     and DamagePerLevel are perc_add per level. AimErrorAtLevel1 and AimErrorAtMaxLevel
     set how well a survivor shoots ([SDCS-AIM]): her spread with a gun is a player's
     AIMED spread with that gun times this factor, 3 at level 1 falling in a straight
     line to 1 at MaxLevel (a level-1 survivor's pipe pistol spreads about as wide as a
     player firing it from the hip, a top-level one like a player aiming down the sights;
     lower = more accurate). MaxLevel is this mod's own level clamp. HarvestPerLevel
     is the extra harvest yield per level above 1 (wood, stone, ore, clay, plants, crops,
     butchering). The
     HealthRegenPerSecond is the slow natural regen on the same buff, in HP per
     SECOND (the engine multiplies by the 0.5 s stat tick), so 0.2 is 1 HP every
     5 s: an NPC tops itself off while it wanders instead of being healed
     instantly on a level-up. StartLevelDaysPerLevel (default 7) is the
     world days per start level: a survivor met on day 8 starts at level 2
     (clamped 1 to 1000). KillXpWorkaround (default true) picks who pays a
     hired survivor her kill XP: true, this mod pays it (SCore's own NPC XP
     postfix is suppressed), so kills and crafts follow one rule; false,
     SCore's postfix pays instead (that needs SCore 3.2.36.628 or newer: older
     builds throw on every NPC kill and cost the player the kill's credit).
     Her XP follows the server's XP Multiplier setting, as yours does; your
     perks do not apply to her. The
     EFFECTIVE values print unconditionally at boot as the [SDCS-LEVEL] line,
     so a missing node shows up in the log, not just in the file.
     NoWear (default true) is the stopgap kill switch for NPC item wear:
     while true, every live SDCS role NPC carries the hidden buff SdcsNoWear
     (Config/buffs.xml), whose DegradationPerUse -1.0 passive makes armor hits,
     melee swings and gunshots do zero new durability damage to its gear; while
     false, the controller removes it and normal wear resumes. NPCs have no
     repair path yet, so all wear is a one-way loss; this stops the ratchet
     until the repair system exists (which retires the feature through this
     same key). To A/B in the field: keep VerboseLogging on, fight a hired NPC
     with NoWear true and expect ZERO [SDCS-WEAR] delta lines; flip to false,
     reload, and the probe logs wear deltas within a minute of fighting. The
     EFFECTIVE value prints unconditionally at boot as part of the [SDCS-LEVEL]
     line (NoWear=...), so a missing node shows up in the log, not just in the file. -->
<Settings>
    <VerboseLogging>false</VerboseLogging>
    <!-- [PLAYERCTRL] own-controller switch (PlayerHumanoidOverride). The
         default is ON since release 3.3.01: Humanoid NPCs get the mod's OWN
         full player controller assets (PlayerHumanoidMale /
         PlayerHumanoidFemale, built into
         Resources/PlayerHumanoidClips.unity3d) instead of the runtime
         AnimatorOverrideController that wraps the game's controller and swaps
         its clips. Set false to fall back to that override path. The
         asset-missing fallback still applies: if the asset is missing from
         the bundle the mod warns once and falls back to the override path. -->
    <PlayerCtrlOwnController>true</PlayerCtrlOwnController>
    <JitterWindow>false</JitterWindow>
    <SdcsPitchPin>true</SdcsPitchPin>
    <NoWear>true</NoWear>
    <!-- [SDCS-SLEEPER] An SDCS survivor standing in a sleeper volume's trigger box makes
         the volume spawn/wake the way a player at that position would (the check mirrors
         the game's own SleeperVolume.CheckTouching with the survivor's position, once per
         second, only while a real player is within 96 m). While false the check never runs
         and a lone survivor in a house stays asleep-safe. The EFFECTIVE value is read with the
         same lazy, warn-once, ParseBool shape as the other keys here; a
         missing node on an old install warns once and keeps the default
         (true). Log tag: [SDCS-SLEEPER]. -->
    <SleeperTrigger>true</SleeperTrigger>
    <!-- [SDCS-SLEEPER] How sleeping zombies and wild survivors deal with each other, read
         once at boot; a missing or unreadable node warns once and keeps the value below.
         SightRangeMetres: how close a sleeping zombie must be to see one of your
             survivors. Clamped 4 to 29 (below the zombie's own 30 m sight range).
         LeaveBeyondMetres: once a house wakes on a wild survivor, how far past it she
             runs before she counts as away. Clamped 10 to 100.
         HouseAvoidSeconds: how long she will not loot that house afterwards (the same
             memory keeps her away from a container she gave up on). Clamped 30 to 3600. -->
    <Sleeper>
        <SightRangeMetres>16</SightRangeMetres>
        <LeaveBeyondMetres>30</LeaveBeyondMetres>
        <HouseAvoidSeconds>300</HouseAvoidSeconds>
    </Sleeper>
    <!-- [SDCS-VEHICLE] Riding and the seated gunner, read once at boot; a missing or
         unreadable node warns once and keeps the value below.
         GunnerMaxRangeMetres: the overall cap on how far a seated gunner fires. Each gun
             fires only within its own damage falloff range under this cap (the game's
             effective range: a pistol about 17 m, a magnum 27 m, rifles reach the cap),
             and an enemy inside the cap keeps her gun out. Clamped 5 to 150.
         GunnerIdleHolsterSeconds: how long she keeps the gun out after the last enemy
             is gone. Clamped 0 to 60.
         BoardRangeMetres: how far from the vehicle a hire walks over to get in.
             Clamped 5 to 100. -->
    <Vehicle>
        <GunnerMaxRangeMetres>40</GunnerMaxRangeMetres>
        <GunnerIdleHolsterSeconds>5</GunnerIdleHolsterSeconds>
        <BoardRangeMetres>30</BoardRangeMetres>
    </Vehicle>
    <!-- [SDCS-STEALTH] An awake EAI observer (a zombie that holds one of our
         survivors as a target, e.g. after she has hit it) passes the survivor
         through the PLAYER's own stealth test (crouch, held light, speed),
         the way the game's EAITarget.check already does for a player. The
         light is computed once per 0.5 s per survivor. While false the patch
         returns at once and an awake observer keeps a survivor target exactly
         as the vanilla non-player branch does. The EFFECTIVE value is read with
         the same lazy, warn-once, ParseBool shape as the other keys here; a
         missing node on an old install warns once and keeps the default (true).
         Log tag: [SDCS-STEALTH]. -->
    <AwakeStealth>true</AwakeStealth>
    <!-- [SDCS-HITBOX] The oversized root hit box. The base game stores the
         root BoxCollider on every entity (Entity.SetupBounds), disables it at
         Awake for any entity with detailed head and body colliders, and
         EntityTrader.OnUpdateLive re-enables it EVERY tick through the same
         cached reference. Every SCore NPC (survivors, legacy NPCs, pets)
         derives from EntityTrader and calls base.OnUpdateLive, so their root
         box (measured 0.73x1.80x0.73 against a 0.70x1.80x0.37 body on the
         field survivor) is live again every tick and fat by 12 to 30 cm:
         hits land beside the body and the interact ray sees a box bigger
         than the model. While true this mod disables the box once per NPC
         (before the trader tick can run) and drops the cached reference,
         the same move SCore already makes at death, so the trader tick has
         nothing to re-enable. The interact prompt is unaffected: the body
         part colliders it resolves through sit on layer 0, which is in the
         interact ray's layer mask. The EFFECTIVE value is read with the same
         lazy, warn-once, ParseBool shape as the other keys here; a missing
         node on an old install warns once and keeps the default (true).
         Log tag: [SDCS-HITBOX]. -->
    <HitBoxFix>true</HitBoxFix>
    <!-- [SDCS-MEASURED] The local NPC's Locomotion-tree feed. While true, a LOCAL
         entity's Forward/Strafe floats are driven by the body's measured horizontal
         travel (a 0.2 s window projected on facing and right, smoothed with a
         0.15 s lag); the commanded value stands for the first frames, a teleport
         and a bad frame. While false the animator is fed the commanded value
         directly, exactly the pre-measured behaviour, for an install where the
         smoothed measured feed still reads as jittery (a raw per-frame measured
         speed is far noisier than a player's and jitters visibly). The value is
         read once per process with the same lazy, warn-once, ParseBool shape as
         the other keys here; a missing node on an old install warns once and
         keeps the default (true). Log tag: [SDCS-MEASURED]. -->
    <AnimFromMeasuredSpeed>true</AnimFromMeasuredSpeed>
    <!-- [SDCS-BURST] The gun burst gate. npcSdcsBase
         sets AttackTimeoutDay/Night to 0.05, so the SCore attack task attempts every
         tick and each gun's own Delay (60 / RoundsPerMinute) sets its cadence.
         Unpaced, that multiplies gun DPS 2 to 5x and empties the 60-round spawn
         grant in seconds, so the gate fires in BURSTS at the weapon's rate, then
         pauses, and the AVERAGE rate lands on a tunable target:
         GunBurstTargetRpsAuto: average rounds per second for fully-automatic guns
             (burst count 0, the game's own GetBurstCount == 0 test). Raise for
             more fire, lower for less.
         GunBurstTargetRpsSemi: average rounds per second for everything else
             (pistols, semi rifles, bows). Raise for more fire, lower for less.
         GunBurstWindow: the burst LENGTH in seconds; an automatic's burst size
             is round(RPS x window), clamped to 2 to 10 rounds; a non-automatic
             fires one round per burst. A bigger window means longer bursts and
             longer pauses. A gun not faster than its target keeps its own
             rhythm (no pacing at all).
         GunBurstEnabled: the whole gate. While false, the gate never skips
             anything and every gun just fires at its own weapon rate. -->
    <GunBurstEnabled>true</GunBurstEnabled>
    <GunBurstTargetRpsAuto>2.0</GunBurstTargetRpsAuto>
    <GunBurstTargetRpsSemi>1.5</GunBurstTargetRpsSemi>
    <GunBurstWindow>0.5</GunBurstWindow>
    <!-- [SDCS-HEAL] The heal roll and bandage timing. The clip at its own pace covers
         5.02 m in 2.4 s, about a zombie's walking pace, followed by 2.5 s of standing
         bandage, so a patient zombie reaches the survivor mid-heal; these settings are
         the fix (Core/Pure/HealTimingRules clamps both).
         HealRollSpeed: how fast the roll plays; a multiplier on the clip,
             1.0 = the clip's own 2.37 s. The commanded move speed scales up with it,
             so the same 5 m is still covered. Clamped 0.5 to 3.0; a missing or corrupt
             node plays as shipped (1.6).
         HealBandageSeconds: how long she holds the bandage before the health is applied
             (the old standing bandage was 2.5). Clamped 0.8 to 5.0; a missing or corrupt
             node plays as shipped (1.5). -->
    <HealRollSpeed>1.6</HealRollSpeed>
    <HealBandageSeconds>1.5</HealBandageSeconds>
    <!-- [SDCS-ANYWEAPON] The backpack watch. A HIRED
         SDCS NPC switches to a weapon when one is put into (or taken out of) its
         backpack - never continuously. What counts as a weapon is the item's own
         data (Core/Pure/AnyWeaponRules), so any player weapon from any mod
         qualifies. The watch polls the player-writable store at 1 Hz and acts
         only once the contents have been unchanged for the settle time, so
         nothing happens while the player is still moving items around. The most
         recently given usable weapon wins; a ranged one needs its own ammo.
         AnyWeaponEnabled: the whole feature. While false, the backpack is not
             even polled.
         AnyWeaponSettleSeconds: how long the changed backpack must sit unchanged
             before the NPC equips. Raise it to make the NPC more deliberate, lower
             it (minimum ~1, the poll cadence) for a snappier response. -->
    <AnyWeaponEnabled>true</AnyWeaponEnabled>
    <AnyWeaponSettleSeconds>2.0</AnyWeaponSettleSeconds>
    <!-- [PLAYERCTRL] What a player-controller NPC does with its held weapon the first
         time it is dead. The item
         hangs on the hand frame (Origin/IKWeapon/IKHandR), under no bone, so
         when the ragdoll drops the bones the weapon otherwise freezes in the
         air until the corpse is removed. Values: vanish (default) unseats the
         held item the way the game does on an inventory change (park on the
         entity's inactive-item transform, deactivate) plus the left-hand
         item parts; fall re-parents the held item onto the right-hand BONE
         (worldPositionStays) so it keeps its death pose and rides the
         ragdoll down, and the left parts onto the left-hand bone. An unknown
         value warns once and means vanish. Only the player-controller line
         (AvatarMixamoPlayerController) is affected; the player-built
         npcSdcs* line already rides the hand bone. One line per death in
         Player.log: [PLAYERCTRL] death <id> weapon='<item>' mode=... -->
    <PlayerCtrlDeathWeapon>vanish</PlayerCtrlDeathWeapon>
    <!-- SdcsModelYOffset: the lift (metres) applied to the SDCS survivor's
         model rig at spawn - the rig is placed at local (0, this, 0) under
         the model parent instead of the stock (0, 0, 0). The stock
         third-person SDCS rig rests about 8 cm below its origin, so the
         default 0.08 lifts it until the soles sit on the ground. Set 0 to
         return to the stock placement; the value is clamped to -1.0 to
         1.0 so a centimetre/metres typo cannot float the rig. Takes effect
         for NPCs spawned after a restart. -->
    <SdcsModelYOffset>0.08</SdcsModelYOffset>
    <!-- [SDCS-PATH] The NPC path rules: while true, the mod's own traversal provider replaces the game's for the SDCS survivors' paths. -->
    <NpcPathRules>true</NpcPathRules>
    <!-- [SDCS-PATH] The cost (A* penalty units) a hazard-marked node (spikes, barbed wire, cactus) costs on a survivor path: expensive, never forbidden, so a wall of spikes is crossed only when it is the only way. -->
    <NpcPathSpikeCost>1000000</NpcPathSpikeCost>
    <!-- [SDCS-PATH] The plan-time drop cap in blocks: a grid step that drops more than this many blocks is not routed (0 disables the cap). -->
    <NpcPathMaxDropBlocks>5</NpcPathMaxDropBlocks>
    <!-- [SDCS-PATH] Extra cost (A* penalty units) a clean node pays when one of its four linked grid neighbours is a hazard column, so the search keeps a one cell buffer off spikes where there is room (0 disables the margin). -->
    <NpcPathHazardMargin>4000</NpcPathHazardMargin>
    <!-- [SDCS-PATH] The move speed (m/s) an SDCS survivor is capped to while a contact damage block sits in her 3 x 3 feet neighbourhood (feet level and one below): the move helper cuts corners at speed, so this slows her where she can still clip a spike in short clusters. 0 disables the cap. -->
    <NpcHazardWalkSpeed>1.0</NpcHazardWalkSpeed>
    <!-- [SDCS-PATH] The standing step-out: when a NOT moving SDCS survivor's body box is in contact with a contact damage block (spikes that powered on under her, a spawn into spikes), she is walked to the nearest standable, contact free cell centre, re-issued every 0.25 s probe while she stays in contact. false disables the step-out entirely (the moving rules above are untouched). -->
    <NpcHazardStepOut>true</NpcHazardStepOut>
    <!-- [SDCS-PATH] The damage an SDCS survivor takes on a first touch of a contact damage block (spikes, barbed wire, cactus); a hit within 3 s of her previous contact hit is staying and deals normal damage. -1 turns the rule off. -->
    <NpcHazardFirstTouchDamage>1</NpcHazardFirstTouchDamage>
    <!-- [SDCS-CUSTOM] The chance that a newly spawned wild survivor is one of an online player's own creator characters of the same sex; 0 turns it off. A fresh spawn of a wild survivor class (one with a SdcsLookArchetypes pool and a Names list) rolls this once, deterministically from its entity id; on a take it is dressed as a random online character of the class's sex and keeps that look for good (a later hire keeps it, the look rides the NPC's own cvars). Clamped 0 to 1 by the loader. -->
    <SdcsCustomCharacterChance>0.1</SdcsCustomCharacterChance>
    <!-- [SDCS-LOOK] ArmorGroup names (comma separated) never rolled for an NPC:
         outfits that render badly on one, e.g. cloth parts the engine only
         simulates for players. Matching is case-insensitive; an empty node
         excludes nothing. The value is latched once per process with the same
         lazy, warn-once shape as the other keys; a missing node keeps the
         shipped default (groupPreacher) with a one-time warning.
         Log tag: [SDCS-LOOK]. -->
    <SdcsArmorExcludeGroups>groupPreacher</SdcsArmorExcludeGroups>
    <Progression>
        <HealthPerLevel>0.03</HealthPerLevel>
        <DamagePerLevel>0.02</DamagePerLevel>
        <AimErrorAtLevel1>3</AimErrorAtLevel1>
        <AimErrorAtMaxLevel>1</AimErrorAtMaxLevel>
        <HarvestPerLevel>0.10</HarvestPerLevel>
        <MaxLevel>10</MaxLevel>
        <StartLevelDaysPerLevel>7</StartLevelDaysPerLevel>
        <HealthRegenPerSecond>0.2</HealthRegenPerSecond>
        <KillXpWorkaround>true</KillXpWorkaround>
    </Progression>
    <!-- Work-site scan radii in metres around the worker's post: HarvestRadius is how far the chop-wood, mine-stone and pick-plants scans reach; ClayRadius does the same for dig-clay (clay is everywhere, so it stays smaller). Both are clamped to 4-40 m by the loader, so a hand-typed 0 or 500 cannot break a scan. -->
    <WorkSite>
        <HarvestRadius>20</HarvestRadius>
        <ClayRadius>8</ClayRadius>
        <!-- MineVeinDepthLayers: how many layers of an ore vein she mines,
             counted down from the surface as she first saw it. Clamped 1 to 10.
             SwingBudgetSeconds: how long she keeps swinging at one tree, rock,
             plant or corpse before skipping it (harvest and butcher). Clamped
             5 to 600. WalkBudgetSeconds: how long she keeps walking to one
             target before skipping it (harvest, butcher and the base keeper).
             Clamped 5 to 120. -->
        <MineVeinDepthLayers>2</MineVeinDepthLayers>
        <SwingBudgetSeconds>60</SwingBudgetSeconds>
        <WalkBudgetSeconds>15</WalkBudgetSeconds>
    </WorkSite>
    <!-- [SDCS-BASEKEEP] The priority a plain "repair the base" order uses:
         base (the most damaged repairable block first) or combat (a block
         damaged in the last few seconds first, the wall under attack).
         Case-insensitive; an unknown value warns once and means base. The
         EFFECTIVE value is read with the same lazy, warn-once string shape
         as the other keys here (the pure parse is test-pinned).
         Log tag: [SDCS-BASEKEEP]. -->
    <BaseKeeper>
        <DefaultMode>base</DefaultMode>
        <!-- RescanSeconds: how often she rescans the base for new damage (and
             rebuilds her material chests). Clamped 5 to 300.
             AreaRadiusMetres: how far her worked area reaches; she finishes it
             before moving on to the next worst cluster, and two keepers stay
             this far apart. Clamped 2 to 40.
             UnderAttackSeconds: in combat repair, a block hit within this many
             seconds counts as under attack and comes first. Clamped 1 to 60.
             ChestReachMetres: how far a chest that is not broadcast may sit from
             her post and still feed her repairs (broadcast chests anywhere in the
             claims always count). Clamped 2 to 40. -->
        <RescanSeconds>30</RescanSeconds>
        <AreaRadiusMetres>8</AreaRadiusMetres>
        <UnderAttackSeconds>5</UnderAttackSeconds>
        <ChestReachMetres>15</ChestReachMetres>
    </BaseKeeper>
    <!-- [SDCS-CRAFT] The craft order. PostReachMetres: how close to her post
         she must stand to craft; farther away (after a fight) her Guard
         order walks her back first. Clamped 1 to 20; a missing or unreadable
         node warns once and keeps 4. The value in force prints once as the
         [SDCS-CRAFT] settings line. Her material chests are the base
         keeper's: ChestReachMetres above.
         StationReachMetres: how close to where you stand a workstation
         must be for its recipes to show in Craft (walk to the forge and
         ask her there). Clamped 1 to 10, default 5.
         StationFuel: what she feeds a forge or campfire that would run
         dry before her items are done, the first one found first, a
         comma list of item names.
         CookStations, BlacksmithStations, ChemistStations,
         CrafterStations: the workstations each specialist role may use,
         a comma list of crafting areas (a recipe's craft_area). Every
         survivor crafts from her backpack anywhere; a workstation needs
         the role whose list holds it (toggled on her from the order
         wheel's Roles page or by voice) and must stand in your or an
         ally's land claim (a field station also away from one, below).
         Add a modded station's area to a list to let that role use it.
         ForgeStockUnits: a Blacksmith keeps each forge material she has
         ore for at this many units (iron, clay and so on): she puts raw
         ore in when she starts a forge order and again when her crafts
         are done, smelting what an order needs first. 0 = only what an
         order needs. Clamped 0 to 30000.
         SmeltOre: the raw items she may put in a forge, a comma list of
         item names (never a tool, weapon or part that also smelts).
         FieldStations: the workstations she may also use where there is
         no land claim, but never in another player's claim: the
         campfire, a field station you place anywhere. A comma list of
         crafting areas; empty = every workstation needs a claim.
         StationWanderMetres: when a workstation order ends she stays at
         the station until you give her an order, walking around within
         this many metres of it. A hire you tell to stay within this
         distance of a workstation walks around it the same way. A backpack
         order always brings her back. 0 = she stands at her spot. Clamped
         0 to 20, default 5.
         StationTools: each workstation's tool slots in the game's own order
         (area=tool,tool,tool; stations separated by ;). A tool a recipe needs
         that she carries (her pack or a chest in reach) and the station lacks
         goes into its own slot when she crafts, and stays there. A station
         or tool not listed here: she never puts one in. -->
    <Crafting>
        <PostReachMetres>4</PostReachMetres>
        <StationReachMetres>5</StationReachMetres>
        <StationFuel>resourceWood,resourceCoal</StationFuel>
        <CookStations>campfire</CookStations>
        <BlacksmithStations>forge</BlacksmithStations>
        <ChemistStations>chemistryStation</ChemistStations>
        <CrafterStations>workbench,cementMixer</CrafterStations>
        <ForgeStockUnits>1000</ForgeStockUnits>
        <SmeltOre>resourceScrapIron,resourceScrapBrass,resourceScrapLead,resourceCrushedSand,resourceClayLump,resourceRockSmall</SmeltOre>
        <FieldStations>campfire</FieldStations>
        <StationWanderMetres>5</StationWanderMetres>
        <StationTools>campfire=toolCookingPot,toolCookingGrill,toolBeaker;forge=toolBellows,toolAnvil,toolForgeCrucible</StationTools>
    </Crafting>
    <!-- [SDCS-MEDIC] The low-health lines the medic treats a patient at, in percent of the patient's max health. InCombatHealthPercent applies while an enemy is visible (in combat, only low health counts) and AfterCombatHealthPercent applies once the combat-ended clock has passed its grace. SelfHealHealthPercent is the survivor's own low-health self-heal line, DireHealthPercent the dire line below it (the first aid kit and the pain pills tier), SelfHealCooldownSeconds the wait between low-health self-heals, and BleedRecheckSeconds the wait before a new bleed may trigger another treatment. The three percent lines clamp to 1 to 99 (a dire line at or above the self-heal line warns once and keeps 25), the two seconds lines clamp at 0, and a missing or unreadable node warns once and keeps its default. All six effective values print once at first read as the [SDCS-MEDIC] line. -->
    <Medic>
        <InCombatHealthPercent>50</InCombatHealthPercent>
        <AfterCombatHealthPercent>50</AfterCombatHealthPercent>
        <SelfHealHealthPercent>70</SelfHealHealthPercent>
        <DireHealthPercent>25</DireHealthPercent>
        <SelfHealCooldownSeconds>30</SelfHealCooldownSeconds>
        <BleedRecheckSeconds>10</BleedRecheckSeconds>
    </Medic>
    <!-- [SDCS-COMBAT] The six combat rules, read once at boot with the same
         lazy, warn-once shape as the other sections; a missing or unreadable
         node warns once and keeps the value below (which is the value the
         code used before this section existed), so nothing changes in play.
         WildTargetedRadiusMetres: how far a zombie that HAS HER as its
             target still provokes a wild (unhired) survivor into fighting
             it. The voice mod's engagement consideration reads the same
             effective value through the mod bridge. Clamped 1 to 60.
         CloseMeleeEnterMetres: an NPC holding a ranged weapon swaps to melee
             at/below this distance. Clamped 0.5 to 20.
         CloseMeleeExitMetres: the swap back to the ranged weapon beyond this
             distance. It must sit ABOVE CloseMeleeEnterMetres (the hysteresis
             band); if it does not, the mod warns once and uses Enter + 2.
         CloseMeleeMinHoldSeconds: minimum seconds on the melee swap before an
             exit is allowed, so a poking enemy cannot ping-pong the hand.
             Clamped 0 to 30.
         CrawlerAimHeadMetres: on a dedicated server (where a crawler's
             skeleton is never animated) the head aim point is replaced with
             this height above the entity root. Clamped 0.05 to 1.5.
         CrawlerAimBellyMetres: the belly aim point, the same way. It must sit
             BELOW CrawlerAimHeadMetres; if it does not, the mod warns once
             and uses Head - 0.2.
         ClearShotStepMetres: a gun-armed hire whose leader stands in her line of fire
             to an enemy going for him steps this far aside (away from him) for a
             clear shot. Clamped 1 to 5.
         ClearShotLeaderRadiusMetres: only for an enemy this close to the leader.
             Clamped 2 to 60. -->
    <Combat>
        <WildTargetedRadiusMetres>15</WildTargetedRadiusMetres>
        <CloseMeleeEnterMetres>3</CloseMeleeEnterMetres>
        <CloseMeleeExitMetres>5</CloseMeleeExitMetres>
        <CloseMeleeMinHoldSeconds>3</CloseMeleeMinHoldSeconds>
        <CrawlerAimHeadMetres>0.45</CrawlerAimHeadMetres>
        <CrawlerAimBellyMetres>0.25</CrawlerAimBellyMetres>
        <ClearShotStepMetres>2</ClearShotStepMetres>
        <ClearShotLeaderRadiusMetres>20</ClearShotLeaderRadiusMetres>
    </Combat>
    <!-- [SDCS-FOLLOW] How a hired survivor paces herself while following
         you, read once at boot; a missing or unreadable node warns once and
         keeps the value below (the value the code used before this section).
         PaceNearDistMetres: at or below this distance from you she walks.
             Clamped 1 to 60.
         PaceFarDistMetres: at or above this distance she moves at the full
             speed her task asks for; between the two the speed blends. It
             must sit ABOVE PaceNearDistMetres (max 80); if it does not, the
             mod warns once and uses Near + 2.
         PaceNearWalkSpeedMps: her walking speed near you, in metres per
             second. It must be at least 0.5 and BELOW the run-gait switch
             (2.75), or walking beside you plays as a run; if it is not, the
             mod warns once and uses 2. -->
    <Follow>
        <PaceNearDistMetres>8</PaceNearDistMetres>
        <PaceFarDistMetres>10</PaceFarDistMetres>
        <PaceNearWalkSpeedMps>2</PaceNearWalkSpeedMps>
    </Follow>
    <!-- [SDCS-LOOT] What a hired survivor keeps from her looting and how far
         she ranges, read once at boot; a missing or unreadable node warns
         once and keeps the value below (the value the code used before this
         section).
         BagMaxMedical: medical units she keeps in her own bag; the rest goes
             to your harvest window. 0 keeps none. Clamped 0 to 100.
         BagMaxAmmoStacks: full stacks of each carried gun's ammo she keeps
             in her own bag. 0 keeps none. Clamped 0 to 20.
         VerticalReachMetres: how far above or below you she loots: one
             storey by default, so she clears the room above or below you
             but not the whole building. The horizontal reach is the loot
             action's own leaderRange. Clamped 1 to 20.
         ReturnTeleportMetres: after "loot around here" ends, within this
             distance she walks back to you; beyond it she teleports. Kept
             below the stay-post leash 45. Clamped 5 to 44. -->
    <Loot>
        <BagMaxMedical>5</BagMaxMedical>
        <BagMaxAmmoStacks>2</BagMaxAmmoStacks>
        <VerticalReachMetres>3</VerticalReachMetres>
        <ReturnTeleportMetres>40</ReturnTeleportMetres>
    </Loot>

    <!-- [SDCS-AMMO] A hired survivor inside your land claim (or an ally's)
         tops up the ammo for her gun from the base's containers when her
         spare rounds for it drop below one magazine: broadcast storage
         anywhere in the claims and the unlocked chests you or your allies
         placed within BaseKeeper ChestReachMetres of her, never her own pack
         and never another player's box. She takes it from where she stands,
         into her pack. Read once at boot; a missing or unreadable node warns
         once and keeps the value below.
         RestockTarget: the spare rounds she tops up to, per gun. 0 = she
             never restocks. Clamped 0 to 5000.
         RestockCheckSeconds: how often she checks. Clamped 1 to 120.
         RestockRetrySeconds: after a check that took nothing (no ammo in
             the base, or she is outside it), the wait before the next.
             Clamped 5 to 600. -->
    <Ammo>
        <RestockTarget>120</RestockTarget>
        <RestockCheckSeconds>5</RestockCheckSeconds>
        <RestockRetrySeconds>30</RestockRetrySeconds>
    </Ammo>

    <!-- [SDCS-LEAD] Your Charismatic Nature perk on your hired survivors (the game's
         perk reaches only other players): its ranks as the game has them, read from
         your current rank once a second; nothing while you are not in the world.
         Read once at boot; a missing or unreadable node warns once and keeps the
         value below (the game's own number).
         RegenPerSecond: rank 1 and up, health she regains per second. Clamped 0 to 5.
         DamageBonus: rank 2 and up, the extra damage she deals (0.2 = 20 percent),
             to blocks too with a melee weapon. Clamped 0 to 1.
         DamageResist: rank 3 and up, the share of damage she does not take
             (0.1 = 10 percent). Clamped 0 to 0.9. -->
    <Leadership>
        <RegenPerSecond>0.5</RegenPerSecond>
        <DamageBonus>0.2</DamageBonus>
        <DamageResist>0.1</DamageResist>
    </Leadership>

    <!-- [SDCS-BANDIT] The bandits (npcSdcsBandit* classes).
         PlayerDamage: the damage a bandit deals to a PLAYER, as a multiplier on
             her weapon's own (1 = full, 0.5 = half). Only players: survivors,
             zombies and animals take full damage. Change it while playing with
             the console command sdcsbandit damage 0.75 (that lasts until the game
             restarts; edit this value to keep it). Clamped 0 to 5.
         SpreadByTier: an EXTRA spread for a bandit, by her tier (T1, T2, T3), added to
             her hip spread on top of the aim every survivor has (Progression
             AimErrorAtLevel1): 0 = she shoots like a survivor of her level, 1 = one
             more hip spread of her gun. Clamped 0 to 10 each.
         SeekMemorySeconds: how long a bandit keeps seeking an enemy she lost sight of,
             from the last moment she saw it (or was hit by it); then she gives up.
         SeekArriveMetres: close enough to the last-seen spot to count as having got
             there and start searching.
         SeekSearchSeconds: how long she searches the spot for it before giving up
             and resting.
         SeekHitSeedSeconds: a shot re-seeds the seek only this fresh (measured from
             the last time she was hit by anyone); a give-up does not re-arm the
             seek until a new shot lands inside this window.
         SeekLookTurnSeconds: during the search, her look turns to a fresh random
             point at this interval.
         SeekLookMetres: how far away those search look points are. -->
    <Bandits>
        <PlayerDamage>0.5</PlayerDamage>
        <SpreadByTier>0,0,0</SpreadByTier>
        <SeekMemorySeconds>20</SeekMemorySeconds>
        <SeekArriveMetres>2</SeekArriveMetres>
        <SeekSearchSeconds>6</SeekSearchSeconds>
        <SeekHitSeedSeconds>1.5</SeekHitSeedSeconds>
        <SeekLookTurnSeconds>1.5</SeekLookTurnSeconds>
        <SeekLookMetres>5</SeekLookMetres>
    </Bandits>

    <!-- [SDCS-REPAIRSKILL] A hired keeper learns to repair by repairing. Every paid
         repair swing and every rebuilt block pays her the repair XP a player earns
         for the same materials, into her repair XP and her level. Her repair XP sets
         the strongest building material she may work; workstations, traps and
         electrics are open to every keeper. Read once at boot; a missing or
         unreadable node warns once and keeps the value below.
         Enabled: false = every keeper repairs everything (the XP still counts).
         StartTier: what a new hire may repair: 0 wood, 1 cobblestone, 2 concrete,
             3 steel.
         CobblestoneXp, ConcreteXp, SteelXp: the repair XP each tier takes (a full
             wood repair pays about 4, cobblestone or concrete about 32).
         WoodMaxDamage, CobblestoneMaxDamage, ConcreteMaxDamage: a block's tier is
             its material's strength (MaxDamage): up to WoodMaxDamage the wood tier
             (sandbags, frames, wood), up to CobblestoneMaxDamage cobblestone (brick,
             scrap metal), up to ConcreteMaxDamage concrete, above that steel. -->
    <RepairSkill>
        <Enabled>true</Enabled>
        <StartTier>0</StartTier>
        <CobblestoneXp>100</CobblestoneXp>
        <ConcreteXp>900</ConcreteXp>
        <SteelXp>1700</SteelXp>
        <WoodMaxDamage>500</WoodMaxDamage>
        <CobblestoneMaxDamage>1500</CobblestoneMaxDamage>
        <ConcreteMaxDamage>5000</ConcreteMaxDamage>
    </RepairSkill>

    <!-- [SDCS-CRAFTSKILL] A specialist learns her craft by crafting. Every craft a
         workstation makes for her counts in each role she holds whose stations
         (Crafting, CookStations and the rest) include that station. Her skill in
         the role is those crafts divided by CraftsPerLevel, and each of the game's
         crafting skills on the role's list is raised to at least that level in her
         own progression: the game's recipe unlocks and craft quality read it there,
         the same way they read a player's. A skill never drops, and it stays when
         she drops the role. Backpack crafts do not count. Read once at boot.
         Enabled: false stops the learning (what she has learned stays).
         CraftsPerLevel: the crafts a skill level takes, clamped 1 to 1000. With 10,
             a new Cook can make corn on the cob after 20 crafts at the campfire.
         CookSkills, BlacksmithSkills, ChemistSkills, CrafterSkills: the game's
             crafting skills each role learns, a comma list of progression.xml
             names. The defaults are the skills of the recipes each role's stations
             make; a name that is not a crafting skill is skipped with a warning. -->
    <CraftSkill>
        <Enabled>true</Enabled>
        <CraftsPerLevel>10</CraftsPerLevel>
        <CookSkills>craftingFood,craftingMedical</CookSkills>
        <BlacksmithSkills>craftingWorkstations,craftingExplosives</BlacksmithSkills>
        <ChemistSkills>craftingMedical,craftingVehicles,craftingExplosives,craftingElectrician,craftingFood</ChemistSkills>
        <CrafterSkills>craftingArmor,craftingBackpack,craftingBlades,craftingBows,craftingClubs,craftingElectrician,craftingExplosives,craftingHandguns,craftingHarvestingTools,craftingKnuckles,craftingMachineGuns,craftingRepairTools,craftingRifles,craftingRobotics,craftingSalvageTools,craftingShotguns,craftingSledgehammers,craftingSpears,craftingTraps,craftingVehicles,craftingWorkstations</CrafterSkills>
    </CraftSkill>

    <!-- [SDCS-TRADE] Selling to a wild survivor: she buys what she can use (medical,
         and ammo for a gun she carries up to her Loot bag cap) at the game's normal
         price, paid from the coins in her bag. Read once at boot.
         StartCoinsMin, StartCoinsMax: the coins a NEW wild survivor starts with, an
             even roll between the two (her purse before anyone buys from her).
             0 and 0 = she starts with none. Clamped 0 to 20000.
         BuyMaxMedical: she buys medical items while her bag holds fewer units than
             this. Keep it above Loot BagMaxMedical: her start kit fills her bag to
             that cap, so at the same value she never buys medical. Clamped 0 to 100. -->
    <Trade>
        <StartCoinsMin>50</StartCoinsMin>
        <StartCoinsMax>150</StartCoinsMax>
        <BuyMaxMedical>10</BuyMaxMedical>
    </Trade>

    <!-- [SDCS-PICKPOCKET] A wild survivor whose class sets SdcsPickpocket="true" (off by
         default: most survivors never steal) picks a player's pocket: one stack from
         his backpack, of the wild loot filter's kind (ListedTags, or worth MinValue a
         unit, dukes always, at most MaxCoins of them). He stops her when he sees her:
         she says a line and backs off for BackOffSeconds, no fight. What she takes goes
         where her loot goes: what she can use into her bag, the rest into her stock for
         sale, so you can buy it back. Single player and the host's own player for now.
         Read once at boot.
         SurvivorMinutes: one attempt per thief per this many minutes.
         VictimMinutes: one attempt on the same player per this many minutes.
         ReachMetres: how close she must be. -->
    <Pickpocket>
        <SurvivorMinutes>10</SurvivorMinutes>
        <VictimMinutes>30</VictimMinutes>
        <ReachMetres>2</ReachMetres>
        <MaxCoins>100</MaxCoins>
        <MinValue>100</MinValue>
        <ListedTags>medical,ammo,food,drinks,csm</ListedTags>
        <BackOffSeconds>5</BackOffSeconds>
    </Pickpocket>

    <!-- [SDCS-GUARD] Survivors told to guard the same spot (a squad Guard order,
         or one Guard order after another from where you stand) spread out
         instead of crowding onto it: the newer posts step aside into a line
         abreast facing your way, then a rank behind.
         SpacingBlocks: blocks between neighbouring posts, 1 to 5.
         PatrolMetres: on Guard and return she walks out to a spot within this
         many metres of her post, looks outward 4 to 10 s, walks back, faces your
         way 4 to 10 s, and repeats (a fight or a talk sends her back first).
         0 = she holds her post. Clamped 0 to 20. -->
    <Guard>
        <SpacingBlocks>2</SpacingBlocks>
        <PatrolMetres>6</PatrolMetres>
    </Guard>
    <!-- [SDCS-WANDER] A survivor or bandit wandering (no order, or the Wander
         order) who gets nowhere, pressed into a car wreck while the wander keeps
         picking new points, gives that wander up and rests a moment before she
         wanders again (the hidden SdcsWanderRest buff in buffs.xml, 10 s).
         StuckMetres: she counts as getting somewhere once she is this far from
             where she last was. Clamped 1 to 10.
         StuckSeconds: she gives up when she has not got that far for this long.
             Clamped 2 to 60. -->
    <Wander>
        <StuckMetres>3</StuckMetres>
        <StuckSeconds>6</StuckSeconds>
    </Wander>
</Settings>
