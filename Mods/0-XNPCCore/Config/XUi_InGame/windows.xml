<configs>
	<!-- 3.0: these are IN-GAME windows; they MUST live in Config/XUi_InGame/ so they
	     load into the in-game window manager. In Config/XUi/ they feed the menu tree
	     only, and windowManager.Open(...) at runtime cannot find them. -->

	<append xpath="/windows">
		<window name="windowLockPicking" pos="0, 60" width="600" height="600" anchor="CenterCenter" controller="PickLocking, SCore" cursor_area="true">
			<panel name="header" height="43" depth="1" backgroundspritename="ui_game_panel_header">
				<sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_pen"/>
				<label style="header.name" text_key="Enter Numeric Pathing Code" width="200"/>
			</panel>
			<rect name="content" pos="0,-46" width="500" height="500" depth="1">
				<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" color="[black]" type="sliced" fillcenter="false"/>
				<sprite color="[darkGrey]" type="sliced"/>
				<textfield name="txtPassword" depth="2" pos="10,-8" width="280" height="32"/>
			</rect>
			<simplebutton name="btnCancel" depth="3" pos="0, -94" width="150" height="36" font_size="32" caption_key="xuiCancel"/>
			<simplebutton name="btnOk" depth="3" pos="300, -94" pivot="right" width="150" height="36" font_size="32" caption_key="xuiSubmit"/>
		</window>
		<window name="windowPathFindingKeypad" pos="-150, 60" width="300" height="120" anchor="CenterCenter" controller="PathFindingKeypadWindow, SCore" cursor_area="true">
			<panel name="header" height="43" depth="1" backgroundspritename="ui_game_panel_header">
				<sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_pen"/>
				<label style="header.name" text_key="Enter Numeric Pathing Code" width="200"/>
			</panel>
			<rect name="content" pos="0,-46" height="50" depth="1">
				<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" color="[black]" type="sliced" fillcenter="false"/>
				<sprite color="[darkGrey]" type="sliced"/>
				<textfield name="txtPassword" depth="2" pos="10,-8" width="280" height="32"/>
			</rect>
			<simplebutton name="btnCancel" depth="3" pos="0, -94" width="150" height="36" font_size="32" caption_key="xuiCancel"/>
			<simplebutton name="btnOk" depth="3" pos="300, -94" pivot="right" width="150" height="36" font_size="32" caption_key="xuiSubmit"/>
		</window>
	</append>
	<append xpath="/windows">
		<window name="windowHireInformation" depth="0" pos="0,-100" width="1000" height="80" controller="DialogHireInformationSDX, SCore">
			<texture name="SMXskillListBG" pos="0,-75" size="1000,80" style="SMX.conversation.trader.background" pivot="center"/>
			<rect name="content" depth="1">
				<label name="header.name" pos="0,-75" size="1000,80" style="SMX.general.panel.title" text="{HireInformation}" color="[white]" pivot="center"/>
			</rect>
		</window>
		<window name="windowHireInformationPopup" depth="0" pos="0,0" width="1000" height="80" controller="HireInformationPopupSDX, SCore">
			<panel name="HireInformationPopup" depth="10000" createuipanel="true" on_hover="true" disableautobackground="true">
				<rect pos="-200,-200" width="400" height="200">
					<panel pos="-20,20" width="440" height="240" clipping="softclip" clippingsoftness="20,20" disableautobackground="true">
						<sprite depth="0" name="backgroundMain" sprite="menu_empty" color="0,0,0,100" type="sliced" fillcenter="true"/>
					</panel>
					<panel name="header" pos="0,0" height="43" depth="1" backgroundspritename="ui_game_panel_header" bordercolor="[black]" borderthickness="3">
						<label style="header.name" name="panelheader" pos="6,-6" width="550" text="Would you like to hire me?"/>
					</panel>
					<rect pos="0,-50" height="106">
						<sprite depth="10" name="border" sprite="menu_empty2px" color="[black]" type="sliced" fillcenter="false" globalopacity="true" globalopacitymod="0.9"/>
						<sprite depth="0" name="backgroundMain" sprite="menu_empty3px" color="[mediumGrey]" type="sliced" fillcenter="true" globalopacitymod="2"/>
						<label name="HireInformationLabel" pos="10,-8" width="380" height="100" pivot="topleft" justify="left" depth="2"/>
					</rect>
					<rect pos="0, -164">
						<simplebutton name="btnCancel" depth="3" pos="0, 0" width="180" height="36" font_size="32" caption_key="xuiCancel"/>
						<simplebutton name="btnConfirm" depth="3" pos="400, 0" pivot="right" width="180" height="36" font_size="32" caption_key="xuiAccept"/>
					</rect>
				</rect>
			</panel>
		</window>
		<window name="windowJoinInformationPopup" depth="0" pos="0,0" width="1000" height="80" controller="JoinInformationPopupSDX, SCore">
			<panel name="JoinInformationPopup" depth="10000" createuipanel="true" on_hover="true" disableautobackground="true">
				<rect pos="-200,-200" width="400" height="200">
					<panel pos="-20,20" width="440" height="240" clipping="softclip" clippingsoftness="20,20" disableautobackground="true">
						<sprite depth="0" name="backgroundMain" sprite="menu_empty" color="0,0,0,100" type="sliced" fillcenter="true"/>
					</panel>
					<panel name="header" pos="0,0" height="43" depth="1" backgroundspritename="ui_game_panel_header" bordercolor="[black]" borderthickness="3">
						<label style="header.name" name="panelheader" pos="6,-6" width="550" text="Would you like to hire me?"/>
					</panel>
					<rect pos="0,-50" height="106">
						<sprite depth="10" name="border" sprite="menu_empty2px" color="[black]" type="sliced" fillcenter="false" globalopacity="true" globalopacitymod="0.9"/>
						<sprite depth="0" name="backgroundMain" sprite="menu_empty3px" color="[mediumGrey]" type="sliced" fillcenter="true" globalopacitymod="2"/>
						<label name="JoinInformationLabel" pos="10,-8" width="380" height="100" pivot="topleft" justify="left" depth="2"/>
					</rect>
					<rect pos="0, -164">
						<simplebutton name="btnCancel" depth="3" pos="0, 0" width="180" height="36" font_size="32" caption_key="xuiCancel"/>
						<simplebutton name="btnConfirm" depth="3" pos="400, 0" pivot="right" width="180" height="36" font_size="32" caption_key="xuiAccept"/>
					</rect>
				</rect>
			</panel>
		</window>
		<window name="NPCCharacterFrameWindow" width="327" height="700" controller="CharacterFrameWindowSDX, SCore" defaultcolor="[white]" hoveredcolor="[selectedColor]" cursor_area="true">
			<panel name="content" pos="10,-20" height="1000" depth="1" backgroundcolor="[darkGrey]" bordercolor="[black]" borderthickness="3" pivot="center">
				<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" height="1000" color="[black]" type="sliced" fillcenter="false"/>
				<label depth="3" name="descriptionText" pos="8,-10" width="544" text="{msgText}" crispness="Never" effect="outline" effect_distance="1,1" effect_color="[black]" font_size="12" overflow="resizeheight"/>
			</panel>
		</window>
	</append>


    <!-- Append our settings button into the vanilla ingameMenu buttons grid (3.0) -->
    <append xpath="//window[@name='ingameMenu']/grid[@name='buttons']">
        <simplebutton name="btnXNPCVoiceControlConfig" depth="3" width="250" height="46"
                      caption_key="vcMenu_SettingsButton" font_size="34"/>
    </append>

    <!-- Main configuration window: 800px tall, centered, fits 1080p. 40px header reserved. -->
    <append xpath="/windows">
        <window name="windowXNPCVoiceControlConfig" depth="99" width="720" height="850"
                pos="-360,400" anchor="CenterCenter" cursor_area="true" controller="XUiC_XNPCVoiceControlConfig, 1-XNPCVoiceControl">

            <panel depth="3" name="content" pos="0,0" width="720" height="850" backgroundcolor="0,0,0,0">

                <!-- Semi-transparent background fill -->
                <sprite depth="1" name="bg" sprite="menu_empty" type="sliced" color="0,0,0,220"
                        pos="0,0" width="720" height="850"/>

                <!-- Header (on the first line, above the grid) -->
                <label depth="15" pos="20,-10" width="680" height="32" text_key="vcSettings_Title"
                       font_size="24" justify="center"/>

                <!-- Close button -->
                <simplebutton enabled="true" name="btnClose" pos="674,-10" width="36" height="32" depth="15"
                              caption="X" font_size="18"/>

                <!-- Settings grid: starts below the 40px header -->
                <grid name="settingsGrid" depth="10" pos="35,-46" cols="1" width="640" height="792"
                      cell_width="640" cell_height="34" arrangement="vertical" repeat_content="false">

                    <!-- TTS Enable -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_Tts" font_size="16" style="label_outline"/>
                        <togglebutton enabled="true" name="toggleTTS" pos="465,-4" width="165" height="26" depth="3"
                                      font_size="15" caption_key="vcSettings_Enabled"/>
                    </panel>

                    <!-- Volume -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_Volume" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderVolume" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="0.0" value_max="1.0" value_increment="0.1" format_string="0.0"/>
                    </panel>

                    <!-- Speech Rate -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_SpeechRate" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderSpeechRate" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="0.5" value_max="2.0" value_increment="0.1" format_string="0.0"/>
                    </panel>

                    <!-- STT Enable -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_Stt" font_size="16" style="label_outline"/>
                        <togglebutton enabled="true" name="toggleSTT" pos="465,-4" width="165" height="26" depth="3"
                                      font_size="15" caption_key="vcSettings_Enabled"/>
                    </panel>

                    <!-- Wake Word Enable -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_WakeWord" font_size="16" style="label_outline"/>
                        <togglebutton enabled="true" name="toggleWakeWord" pos="465,-4" width="165" height="26" depth="3"
                                      font_size="15" caption_key="vcSettings_Enabled"/>
                    </panel>

                    <!-- Beam Size -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_BeamSize" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderBeamSize" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="1.0" value_max="5.0" value_increment="1.0" format_string="0"/>
                    </panel>

                    <!-- Loaded AI Model -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_Model" font_size="16" style="label_outline"/>
                        <textfield enabled="false" name="txtModel" pos="235,-4" width="395" height="26" depth="3"
                                   font_size="16" text="loading..."/>
                    </panel>

                    <!-- Max Tokens -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_MaxTokens" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderMaxTokens" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="64.0" value_max="2048.0" value_increment="64.0" format_string="0"/>
                    </panel>

                    <!-- Context Window -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_ContextWindow" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderMaxHistory" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="3.0" value_max="20.0" value_increment="1.0" format_string="0"/>
                    </panel>

                    <!-- Chat Distance -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_ChatDistance" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderChatDistance" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="3.0" value_max="15.0" value_increment="1.0" format_string="0"/>
                    </panel>

                    <!-- Hired Chat Distance -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_HiredChatDistance" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderHiredChatDistance" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="5.0" value_max="40.0" value_increment="1.0" format_string="0"/>
                    </panel>

                    <!-- Chat Inactivity Timeout -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_ChatTimeout" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderChatTimeout" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="15.0" value_max="120.0" value_increment="5.0" format_string="0"/>
                    </panel>

                    <!-- Voice Range -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_VoiceRange" font_size="16" style="label_outline"/>
                        <combobox enabled="true" type="ComboBoxFloat" name="sliderVoiceDistance" pos="235,-4" width="390" height="26" depth="3"
                                  value_min="5.0" value_max="40.0" value_increment="1.0" format_string="0"/>
                    </panel>

                    <!-- Debug Logging -->
                    <panel width="640" height="34">
                        <label pos="10,-9" width="220" text_key="vcSettings_DebugLogging" font_size="16" style="label_outline"/>
                        <togglebutton enabled="true" name="toggleDebug" pos="465,-4" width="165" height="26" depth="3"
                                      font_size="15" caption_key="vcSettings_Enabled"/>
                    </panel>

                    <!-- Test buttons -->
                    <simplebutton enabled="true" name="btnTestTTS" width="640" height="28" depth="3"
                                  font_size="15" caption_key="vcSettings_TestVoice"/>

                    <simplebutton enabled="true" name="btnTestSTT" width="640" height="28" depth="3"
                                  font_size="15" caption_key="vcSettings_TestMic"/>

                    <simplebutton enabled="true" name="btnTestLLM" width="640" height="28" depth="3"
                                  font_size="15" caption_key="vcSettings_TestAi"/>

                    <simplebutton enabled="true" name="btnClearConversations" width="640" height="28"
                                  depth="3" font_size="15" caption_key="vcSettings_ClearConversations"/>

                    <!-- Save / Cancel -->
                    <simplebutton enabled="true" name="btnSave" width="640" height="32" depth="3"
                                  font_size="17" caption_key="vcSettings_Save"/>

                    <simplebutton enabled="true" name="btnCancel" width="640" height="32" depth="3"
                                  font_size="17" caption_key="xuiCancel"/>

                    <!-- Test / action results. Filled by the controller instead of the NPC
                         subtitle window, which sits behind this panel. Two wrapped lines. -->
                    <panel width="640" height="74">
                        <label name="lblTestResult" pos="10,-9" width="620" height="64" text=""
                               font_size="14" color="255,255,255,255" justify="left"
                               style="label_outline" max_line_count="2"/>
                    </panel>

                </grid>
            </panel>
        </window>
    </append>

    <!-- NPC Subtitle Window -->
    <append xpath="/windows">
        <window name="windowNPCSubtitles" depth="100" width="800" height="156"
                pos="-400,250" anchor="CenterBottom" cursor_area="false"
                controller="XUiC_NPCSubtitles, 1-XNPCVoiceControl">
            <panel depth="1" name="bg" pos="0,0" width="800" height="156"
                   backgroundcolor="0,0,0,180"/>
            <label depth="2" name="lblName" pos="10,-10" width="780" height="30"
                   text="NPC Name" font_size="22" color="255,200,100,255"
                   justify="left" style="label_outline" max_line_count="1"/>
            <label depth="2" name="lblText" pos="10,-44" width="780" height="102"
                   text="Dialogue text goes here..." font_size="22" color="255,255,255,255"
                   justify="left" style="label_outline" max_line_count="3"/>
        </window>
    </append>

    <!-- Order Wheel window: 8 entry slots (repeat_count fixed); pages with fewer sockets leave the rest hidden -->
    <append xpath="/windows">
        <window name="windowVCFormationRadial" anchor="Center" pos="-150,-150" width="600" height="600" cursor_area="true">
            <!-- radialPanel and selection both carry pos="150,150" to cancel the window's pos="-150,-150".
                 If the window pos ever changes, update both offsets here to keep the ring and label centred. -->
            <rect name="radialPanel" pos="150,150" repeat_content="true" repeat_count="8">
                <!-- The shared base-game radial_entry template, expanded INLINE (the base template
                     is used by the vanilla block and toolbelt radials and must not be overridden). Same
                     rect, same controller, same child names (border, background, icon, text).
                     Layout: icon in the upper half, label below it (the base template overlapped the
                     48px ammo-count label onto the icon), label widened to 66px and centred.
                     navicon is ours (a right chevron under the label, hidden by default):
                     the controller shows it on navigation sockets only, replacing the
                     template's "menu" text line. icontext is ours: the icon slot as TEXT,
                     a second label
                     at the icon's pos (0,14) at the big 28pt size, hidden by default; the
                     controller shows it only when the socket's IconText fact is non-empty and
                     hides the sprite in that case (IconText wins over IconSprite). The
                     controller also tints border per socket class (navigation vs command) at
                     runtime. The base RadialEntry controller only binds icon, background and
                     text, so it ignores the navicon and icontext children and never touches
                     the border, which is why the tint survives hover-out (the background
                     colour does not: SetHighlighted reverts it to the Init-cached value). -->
                <rect depth="15" height="75" width="75" style="hover" highlight_color="[selectedColor]" pivot="center" controller="RadialEntry" sound_play_on_hover="[default_hover]">
                    <sprite depth="1" height="79" width="79" name="border" sprite="ui_game_filled_circle" color="0,0,0,128" pivot="center"/>
                    <sprite depth="2" name="background" sprite="ui_game_filled_circle" color="96,96,96,192" pivot="center"/>
                    <sprite depth="3" height="38" width="38" name="icon" atlas="UIAtlas" color="255,255,255,255" pos="0,14" pivot="center" foregroundlayer="true"/>
                    <label depth="4" name="icontext" width="66" height="18" pos="0,14" font_size="28" color="[white]" justify="center" effect="outline" pivot="center" max_line_count="1" visible="false"/>
                    <label depth="4" name="text" width="66" height="18" pos="0,-13" font_size="14" color="[white]" justify="center" effect="outline" pivot="center" max_line_count="1"/>
                    <sprite depth="4" name="navicon" width="16" height="16" pos="0,-26" atlas="UIAtlas" sprite="ui_game_symbol_arrow_right" color="255,255,255,255" pivot="center" visible="false" foregroundlayer="true"/>
                </rect>
            </rect>
            <!-- on_hover makes the base attach a hover listener to this label (InitView
                 checks HasAnyEvent before wiring UIEventListener). XUiC_VCFormationRadial
                 subscribes its OnHover event: the centre is a dwell target (back to page 0).
                 The 150x50 hit area is the centre of the ring; entries sit at radius
                 150, so they never overlap it. -->
            <label depth="10" name="selection" pos="150,150" width="150" height="50" pivot="center" justify="center" font_size="26" on_hover="true"/>
        </window>
    </append>

    <!-- Her craft window (NpcCraftGroup in xui.xml): the game's crafting list and
         info panel, copied in look (layout, styles, sprites) and renamed, driven by
         our own controllers. Every recipe row, ingredient count and the Craft button
         read HER listing and send HER order; nothing here reads the player's own
         inventory. The tab row is the game's own CategoryList (no inventory reads),
         the page arrows the game's own pager. -->
    <append xpath="/windows">
        <window name="windowNpcCraftList" width="397" height="688" panel="Left" cursor_area="true">
            <rect name="header" height="43" depth="1">
                <headerbg />
                <sprite pos="4,-5" depth="2" name="windowIcon" style="icon32px" sprite="ui_game_symbol_workbench"/>
                <label style="header.name" name="title" text="" />
            </rect>

            <rect name="content" height="650" depth="1" pos="0,-43" on_scroll="true">
                <rect depth="2" name="categorySelector" width="390" height="44" pos="3,-6">
                    <sprite name="backgroundMain" sprite="menu_empty3px" pos="-3,3" width="396" height="49" color="[black]" type="sliced" fillcenter="false" />
                    <sprite color="[mediumGrey]" type="sliced" />
                    <grid name="categories" pos="23,-21" rows="1" cols="9" width="390" height="43" cell_width="43" cell_height="43" repeat_content="true" controller="CategoryList">
                        <category_icon />
                    </grid>
                </rect>

                <rect depth="3" name="searchControls" width="390" height="44" pos="3,-52">
                    <sprite name="backgroundMain" sprite="menu_empty3px" pos="-3,3" width="396" height="49" color="[black]" type="sliced" fillcenter="false" />
                    <sprite color="[darkGrey]" type="sliced" />
                    <label depth="4" name="tabName" pos="10,-8" width="270" height="30" text="" font_size="28" color="[beige]" />
                    <rect pos="286,0" width="104" height="43">
                        <pager name="pager" pos="4,-6" contents_parent="content"/>
                    </rect>
                </rect>

                <grid name="recipes" depth="2" rows="12" cols="1" pos="3,-98" width="390" height="552" cell_width="390" cell_height="46" repeat_content="true" arrangement="vertical">
                    <rect height="43" style="press, hover, scroll" controller="XUiC_NpcRecipeEntry, 1-XNPCVoiceControl" sound="[recipe_click]" sound_play_on_hover="[default_hover]">
                        <sprite depth="2" name="backgroundMain" sprite="menu_empty3px" pos="-3,3" width="396" height="49" color="[black]" type="sliced" fillcenter="false" />
                        <sprite depth="3" name="background" height="45" pos="0,1" color="[darkGrey]" type="sliced" />
                        <sprite depth="4" name="icon" atlas="ItemIconAtlas" sprite="" size="40,40" pos="34,-22" pivot="center" foregroundlayer="true"/>
                        <label depth="4" name="name" pos="200,-22" width="270" height="30" text="" font_size="28" justify="center" pivot="center"/>
                        <label depth="4" name="max" pos="384,-22" width="50" height="26" text="" font_size="22" color="[beige]" justify="right" pivot="right"/>
                    </rect>
                </grid>

                <label depth="5" name="waiting" pos="195,-320" width="380" height="40" text="" font_size="28" justify="center" pivot="center" visible="false"/>
            </rect>
        </window>

        <window name="windowNpcCraftJob" width="397" height="52" panel="Left" cursor_area="true">
            <rect depth="1" pos="0,-3" width="397" height="46">
                <sprite depth="2" name="backgroundMain" sprite="menu_empty3px" width="397" height="46" color="[black]" type="sliced" fillcenter="false" />
                <sprite depth="1" pos="3,-3" width="391" height="40" color="[darkGrey]" type="sliced" />
                <sprite depth="3" name="jobIcon" atlas="ItemIconAtlas" sprite="" size="34,34" pos="24,-23" pivot="center" foregroundlayer="true"/>
                <label depth="3" name="jobText" pos="46,-23" width="236" height="28" text="" font_size="24" pivot="left"/>
                <simplebutton name="btnCancel" caption_key="xuiCancel" width="100" height="34" depth="3" pos="290,-23" />
            </rect>
        </window>

        <window name="windowNpcCraftInfo" width="603" height="392" style="crafting.info.window" panel="Center" cursor_area="true">
            <rect name="header" height="43" depth="1">
                <headerbg />
                <sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_resource"/>
                <label style="header.name" name="itemName" text="" />
                <label depth="2" pos="595,-8" name="status" width="250" height="32" text="" font_size="28" color="[red]" upper_case="true" justify="right" pivot="topright"/>
            </rect>

